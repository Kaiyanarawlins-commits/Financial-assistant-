{
  "name": "cashcompass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CashCompass — personal income & spending navigator",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/precache.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "build:standalone": "VITE_SINGLE_FILE=1 npm run build && node scripts/standalone.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
